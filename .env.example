# GATEOPS environment variables. Names only. Copy to .env.local and fill locally.
# See PRD 25.4. Never commit .env.local.

# Supabase project ref (production). Set by setup wizard.
SUPABASE_PROJECT_REF=

# Supabase database password. Requested during setup, never stored.
SUPABASE_DB_PASSWORD=

# Edge Functions base URL. https://<ref>.supabase.co/functions/v1 or localhost for local.
SUPABASE_FUNCTIONS_URL=

# Anon key used only for the BFF Authorization header. Not a secret, never sent to browser.
SUPABASE_ANON_KEY=

# Shared secret between BFF and Edge Functions (32-byte base64url).
GATEOPS_INTERNAL_SECRET=

# Provided automatically inside Edge Functions. Must never be set in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Created by `vercel link` into .vercel/project.json.
VERCEL_PROJECT_ID=