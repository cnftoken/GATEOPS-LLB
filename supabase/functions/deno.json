{
  "lock": true,
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  },
  "tasks": {
    "check": "deno check .",
    "test": "deno test --allow-all ."
  }
}
