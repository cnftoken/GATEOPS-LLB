{
  "name": "gateops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @gateops/web dev",
    "build": "pnpm --filter @gateops/web build",
    "start": "pnpm --filter @gateops/web start",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "pnpm --filter @gateops/web test && pnpm test:setup",
    "test:db": "supabase db query \"create extension if not exists pgtap\" && supabase test db",
    "test:e2e": "pnpm --filter @gateops/web test:e2e",
    "doctor": "tsx scripts/doctor.ts",
    "setup": "tsx scripts/setup.ts",
    "release": "tsx scripts/release.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test:setup": "node --import tsx --test scripts/setup-production.test.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "26.6.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.9",
    "prettier": "3.10.1",
    "supabase": "3.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vercel": "67.0.0"
  },
  "workspaces": [
    "apps/*",
    "scripts"
  ]
}
